<?xml version="1.0" encoding="utf-8"?>
<!-- Backups are the app's own SAF export, not Google's. Nothing leaves the device automatically. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
